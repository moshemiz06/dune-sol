{
  "name": "arrakis-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && npm run export:all && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "export:model": "tsx scripts/export-model.ts",
    "test": "npm run test:models && npm run test:browser",
    "test:models": "tsx --test tests/models.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.html package.json",
    "export:viewer": "tsx scripts/export-inline.ts",
    "export:all": "npm run export:model && npm run export:viewer"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "esbuild": "^0.28.2"
  }
}
